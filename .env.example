# Application
APP_NAME=sia-ai-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Google Gemini / LLM
GEMINI_API_KEY=your-gemini-api-key-here
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_RPM_LIMIT=50
EMBEDDING_TPM_LIMIT=29000
GEMINI_TIMEOUT_SECONDS=30.0

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sia_documents
QDRANT_VECTOR_SIZE=768
RETRIEVAL_SCORE_THRESHOLD=0.45

# Chunker & Chat / RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHAT_HISTORY_MESSAGES=6

# Storage Settings (RustFS Dev / S3 Prod)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=your-storage-access-key-here
STORAGE_SECRET_KEY=your-storage-secret-key-here
STORAGE_BUCKET_NAME=sia-documents
STORAGE_REGION=us-east-1

# Internal Backend Callback
BACKEND_INTERNAL_URL=http://localhost:8080
INTERNAL_API_KEY=your-internal-api-key-here
