# Application
APP_NAME=sia-ai-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Google Gemini / LLM
GEMINI_API_KEY=your-gemini-api-key-here
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sia_documents
QDRANT_VECTOR_SIZE=768
RETRIEVAL_SCORE_THRESHOLD=0.45

# Storage Settings (RustFS Dev / S3 Prod)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=sia-minio
STORAGE_SECRET_KEY=12345678
STORAGE_BUCKET_NAME=sia-documents
STORAGE_REGION=us-east-1

# Internal Backend Callback
BACKEND_INTERNAL_URL=http://localhost:8080
INTERNAL_API_KEY=sia-internal-secret-change-me
